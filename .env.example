# Personal Timezone Calendar Configuration
# Copy this file to .env and customize

# Server port (default: 5001, avoiding macOS AirPlay on 5000)
PORT=5001

# Your default/home timezone (IANA format)
# Used for personal-timezone calendars when no umbrella event provides context
# Examples: America/New_York, America/Los_Angeles, Europe/London, Asia/Tokyo
DEFAULT_TIMEZONE=America/New_York

# Default location for timezone inference (optional)
# Used as a fallback for personal-timezone calendars when no umbrella event matches
# and no calendar-specific target timezone is set. Will be geocoded to determine timezone.
# Examples: "New York, USA", "Detroit, Michigan", "London, UK"
DEFAULT_LOCATION=

# Secret for generating secure feed URLs
# IMPORTANT: Change this to a random string of at least 16 characters
# Generate one with: openssl rand -hex 16
FEED_SECRET=change-me-in-production

# External URL for calendar subscriptions (optional)
# Set this to your public URL if you want others to subscribe to your feeds
# Example: https://calendar.example.com
BASE_URL=
