# Server port (5001 to avoid macOS AirPlay on 5000)
PORT=5001

# Your default timezone (IANA format)
DEFAULT_TIMEZONE=America/Detroit

# Default location for timezone inference (optional)
# Used as a fallback for personal-timezone calendars when no umbrella event matches
# and no calendar-specific target timezone is set. Will be geocoded to determine timezone.
# Examples: "New York, USA", "Detroit, Michigan", "London, UK"
DEFAULT_LOCATION=

# Secret for generating feed tokens (change this!)
FEED_SECRET=your-secret-key-here

# Google Calendar iCal URLs (comma-separated)
# To get your Google Calendar iCal URL:
# 1. Open Google Calendar settings
# 2. Click on the calendar you want to share
# 3. Scroll to "Integrate calendar"
# 4. Copy the "Secret address in iCal format"
GOOGLE_CALENDAR_URLS=
